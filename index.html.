<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>مصحف النور</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#071b1b;color:#f8e8b0;font-family:Tahoma,Arial,sans-serif}
header{text-align:center;padding:22px 12px;background:linear-gradient(135deg,#073c39,#101616);border-bottom:2px solid #cba65b}
.logo{font-size:36px;color:#e8c778;text-shadow:0 0 15px #c69d46}
header p{margin:8px;color:#d6cba8}
.badge{display:inline-block;border:1px solid #bd9851;padding:6px 14px;border-radius:20px;font-size:12px}
main{max-width:720px;margin:auto;padding:14px}
.panel{background:linear-gradient(145deg,#102c29,#091b1a);border:1px solid #92733e;border-radius:18px;padding:16px;margin:14px 0;box-shadow:0 5px 20px #0005}
h2{font-size:19px;color:#e8c778;margin-top:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{text-align:center;background:#15332e;padding:14px;border-radius:12px}
.stat strong{display:block;font-size:20px;color:#e8c778;margin-bottom:5px}
.clock{width:120px;height:120px;border:4px solid #d6b66a;border-radius:50%;margin:12px auto;position:relative;background:#f1e2b5;color:#263b30;box-shadow:0 0 20px #d6b66a44}
.clock:before{content:"";position:absolute;left:50%;top:50%;width:4px;height:34px;background:#243a32;transform:translate(-50%,-100%);transform-origin:bottom;border-radius:5px}
.clock:after{content:"";position:absolute;left:50%;top:50%;width:27px;height:4px;background:#243a32;transform:translateY(-50%);transform-origin:left;border-radius:5px}
.clock span{position:absolute;inset:8px;text-align:center;font-weight:bold;font-size:12px}
input,button{font:inherit}
input{width:100%;padding:12px;border-radius:10px;border:1px solid #92733e;background:#071b1b;color:white;margin:8px 0}
button{border:1px solid #d7b76a;background:linear-gradient(135deg,#c8a45c,#f0d995);color:#102522;padding:11px 14px;border-radius:10px;font-weight:bold;cursor:pointer}
button.secondary{background:#14332e;color:#f7e6b3}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.surah{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 4px;border-bottom:1px solid #ffffff1c}
.surah button{padding:8px}
.ayahs{font-family:serif;font-size:23px;line-height:2.2;text-align:justify;color:#f4e7c1}
footer{text-align:center;padding:22px;color:#bba66f;font-size:12px}
.hidden{display:none}
</style>
</head>
<body>
<header>
<div class="logo">☪ مصحف النور</div>
<p>القرآن الكريم • نور القلوب وطمأنينة الأرواح</p>
<div class="badge">✦ الإصدار الملكي ✦</div>
</header>

<main>
<section class="panel">
<h2>السلام عليك يا أبا عبد الله الحسين ﷺ</h2>
<p>﴿ إِنَّ هَٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ ﴾</p>
<div class="grid">
<div class="stat"><strong id="date"></strong>التاريخ الميلادي</div>
<div class="stat"><strong id="hijri">التقويم الهجري</strong>التاريخ الهجري تقريبي</div>
</div>
<div class="clock"><span>12<br><br>9　　　3<br><br><br>6</span></div>
<div style="text-align:center" id="time"></div>
</section>

<section class="panel">
<h2>✧ رحلة الإيمان ✧</h2>
<div class="grid">
<div class="stat"><strong>١١٤</strong>سورة كريمة</div>
<div class="stat"><strong>٣٠</strong>جزءاً</div>
<div class="stat"><strong>٦٢٣٦</strong>آية تقريباً</div>
<div class="stat"><strong>بداية النور</strong>اقرأ وارتقِ</div>
</div>
</section>

<section class="panel">
<h2>⌕ البحث في السور</h2>
<input id="search" placeholder="اكتب اسم السورة..." oninput="render()">
<div class="actions">
<button onclick="showAll()">عرض جميع السور</button>
<button class="secondary" onclick="showBookmarks()">المحفوظات ★</button>
</div>
<div id="surahs"></div>
</section>

<section class="panel" id="reader">
<h2 id="readTitle">اختر سورة للقراءة</h2>
<p id="readInfo">اضغط على اسم السورة من الفهرس.</p>
<div class="ayahs" id="verses">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
<div class="actions">
<button onclick="bookmark()">★ حفظ علامة مرجعية</button>
<button class="secondary" onclick="copyText()">نسخ النص</button>
<button class="secondary" onclick="fontSize(2)">تكبير الخط</button>
<button class="secondary" onclick="fontSize(-2)">تصغير الخط</button>
</div>
<p id="note">ملاحظة: هذه واجهة أولية؛ نصوص القرآن الكاملة والتفسير والتلاوة الصوتية تحتاج إلى إضافة مصدر موثوق وربطها به.</p>
</section>

<footer>مصحف النور • اللهم اجعل القرآن ربيع قلوبنا ونور صدورنا</footer>
</main>

<script>
const names=`الفاتحة|البقرة|آل عمران|النساء|المائدة|الأنعام|الأعراف|الأنفال|التوبة|يونس|هود|يوسف|الرعد|إبراهيم|الحجر|النحل|الإسراء|الكهف|مريم|طه|الأنبياء|الحج|المؤمنون|النور|الفرقان|الشعراء|النمل|القصص|العنكبوت|الروم|لقمان|السجدة|الأحزاب|سبأ|فاطر|يس|الصافات|ص|الزمر|غافر|فصلت|الشورى|الزخرف|الدخان|الجاثية|الأحقاف|محمد|الفتح|الحجرات|ق|الذاريات|الطور|النجم|القمر|الرحمن|الواقعة|الحديد|المجادلة|الحشر|الممتحنة|الصف|الجمعة|المنافقون|التغابن|الطلاق|التحريم|الملك|القلم|الحاقة|المعارج|نوح|الجن|المزمل|المدثر|القيامة|الإنسان|المرسلات|النبأ|النازعات|عبس|التكوير|الانفطار|المطففين|الانشقاق|البروج|الطارق|الأعلى|الغاشية|الفجر|البلد|الشمس|الليل|الضحى|الشرح|التين|العلق|القدر|البينة|الزلزلة|العاديات|القارعة|التكاثر|العصر|الهمزة|الفيل|قريش|الماعون|الكوثر|الكافرون|النصر|المسد|الإخلاص|الفلق|الناس`.split('|');
let current='';
let bookmarks=JSON.parse(localStorage.getItem('noorBookmarks')||'[]');
function render(list=names){
const q=document.getElementById('search').value.trim();
const arr=list.filter(n=>n.includes(q));
document.getElementById('surahs').innerHTML=arr.map(n=>`<div class="surah"><span>۞ ${n}</span><button onclick="openSurah('${n}')">اقرأ</button></div>`).join('')||'لا توجد نتائج';
}
function showAll(){document.getElementById('search').value='';render()}
function showBookmarks(){document.getElementById('search').value='';render(names.filter(n=>bookmarks.includes(n)))}
function openSurah(n){
current=n;
document.getElementById('readTitle').textContent='سورة '+n;
document.getElementById('readInfo').textContent='تم اختيار السورة. يلزم ربط مصدر قرآني موثوق لعرض جميع آياتها.';
document.getElementById('verses').textContent=n==='الفاتحة'?'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ۝ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ۝ الرَّحْمَٰنِ الرَّحِيمِ ۝ مَالِكِ يَوْمِ الدِّينِ ۝ إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ ۝ اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ۝ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ':'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ';
document.getElementById('reader').scrollIntoView({behavior:'smooth'});
}
function bookmark(){
if(!current){alert('اختَر سورة أولاً');return}
if(!bookmarks.includes(current))bookmarks.push(current);
localStorage.setItem('noorBookmarks',JSON.stringify(bookmarks));
alert('تم حفظ سورة '+current+' في المحفوظات');
}
function copyText(){
const t=document.getElementById('verses').textContent;
if(navigator.clipboard)navigator.clipboard.writeText(t).then(()=>alert('تم النسخ')).catch(()=>alert(t));
else alert(t);
}
function fontSize(d){
const e=document.getElementById('verses');
e.style.fontSize=(parseInt(getComputedStyle(e).fontSize)+d)+'px';
}
function updateClock(){
const now=new Date();
document.getElementById('time').textContent=now.toLocaleTimeString('ar-IQ');
document.getElementById('date').textContent=now.toLocaleDateString('ar-IQ');
try{document.getElementById('hijri').textContent=new Intl.DateTimeFormat('ar-SA-u-ca-islamic',{day:'numeric',month:'short',year:'numeric'}).format(now)}catch(e){}
}
render();updateClock();setInterval(updateClock,1000);
</script>
</body>
</html>
